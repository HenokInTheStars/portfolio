---
import { MORE_PROJECTS } from '../data/projects';
import { previewSvg } from '../lib/previews';
---

<section class="block" id="more" aria-labelledby="more-h">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2 id="more-h">More projects</h2>
      <span class="label">Code on GitHub</span>
    </div>
    <ul class="rows reveal" id="rows">
      {
        MORE_PROJECTS.map((m) => (
          <li>
            <a class="row" href={m.repo} target="_blank" rel="noopener" data-prev={m.preview}>
              <span class="row-name">{m.name}</span>
              <span class="row-line">{m.line}</span>
              <span class="row-stack">{m.stack}</span>
              <span class="row-type label">{m.type}</span>
              <span class="row-arrow" aria-hidden="true">↗</span>
              <span class="sr-only">(code on GitHub, opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div hidden id="preview-store">
    {MORE_PROJECTS.map((m) => <div data-preview={m.preview} set:html={previewSvg(m.preview)}></div>)}
  </div>
  <div class="row-preview" id="row-preview" aria-hidden="true"></div>
</section>

<script>
  import { finePointer, prefersReducedMotion } from '../scripts/motion';

  // A preview card follows the cursor over each row, easing behind it with a slight tilt.
  const rows = document.getElementById('rows');
  const preview = document.getElementById('row-preview');
  if (rows && preview && finePointer()) {
    let tx = 0, ty = 0, x = 0, y = 0;
    let active = false;
    let raf = 0;

    const loop = () => {
      const k = prefersReducedMotion() ? 1 : 0.16;
      x += (tx - x) * k;
      y += (ty - y) * k;
      const tilt = prefersReducedMotion() ? 0 : Math.max(-8, Math.min(8, (tx - x) * 0.06));
      preview.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) rotate(${tilt.toFixed(2)}deg)`;
      raf = active || Math.abs(tx - x) > 0.5 || Math.abs(ty - y) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    const target = (e: PointerEvent) => {
      tx = Math.min(e.clientX + 28, window.innerWidth - 300);
      ty = Math.max(8, Math.min(e.clientY - 90, window.innerHeight - 190));
    };
    const hide = () => {
      active = false;
      preview.classList.remove('show');
    };

    rows.querySelectorAll<HTMLElement>('.row').forEach((row) => {
      row.addEventListener('pointerenter', (e) => {
        const stored = document.querySelector(`#preview-store [data-preview="${row.dataset.prev}"]`);
        if (stored) preview.innerHTML = stored.innerHTML;
        target(e);
        if (!active && !preview.classList.contains('show')) {
          x = tx;
          y = ty;
        }
        active = true;
        preview.classList.add('show');
        if (!raf) raf = requestAnimationFrame(loop);
      });
      row.addEventListener('pointermove', target);
    });
    rows.addEventListener('pointerleave', hide);
    window.addEventListener('scroll', () => active && hide(), { passive: true });
  }
</script>
