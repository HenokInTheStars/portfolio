# Server config for the LiteSpeed/Apache host serving www.henoksolomon.com

# Custom "lost in space" page for missing URLs
ErrorDocument 404 /404.html

# No directory listings
Options -Indexes

# Block hidden files and folders (.git, .env, …) except Let's Encrypt validation
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Always use https and the www host
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

# Hashed build assets never change; everything else revalidates
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
